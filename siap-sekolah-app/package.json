{
  "name": "siap-sekolah-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 execute siap-sekolah-db --local --file=./drizzle/0000_numerous_randall_flagg.sql && wrangler d1 execute siap-sekolah-db --local --file=./drizzle/seed.sql",
    "db:remote": "wrangler d1 execute siap-sekolah-db --file=./drizzle/0000_numerous_randall_flagg.sql && wrangler d1 execute siap-sekolah-db --file=./drizzle/seed.sql",
    "deploy": "npm run build:cf && wrangler pages deploy"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.43.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.52.0",
    "next": "^15.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/serviceworker": "^0.0.202",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^15.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
